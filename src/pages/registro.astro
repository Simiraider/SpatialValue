---
import Layout from "../layouts/Layout.astro";
import { Button } from "../components/ui/Button";
import { Input } from "../components/ui/Input";
import Logo from "../components/Logo.astro";
import "../styles/auth.css";
---

<Layout title="Crear cuenta">
  <div class="auth-page">
    <div class="auth-card my-8">
      <header class="mb-8 text-center flex flex-col items-center">
        <a href="/" class="text-white mb-4 block scale-125">
          <Logo />
        </a>
        <h1 class="auth-title">Registrarse</h1>
        <p class="auth-status" id="mensaje-estado">
          Empezá a tasar propiedades en segundos
        </p>
      </header>

      <form class="flex flex-col gap-5" id="register-form" novalidate>
        <div class="flex gap-4">
          <div class="text-slate-300 w-1/2">
            <Input
              label="Nombre"
              type="text"
              id="register-nombre"
              name="nombre"
              placeholder="Juan"
              autoComplete="given-name"
              required
              client:load
              className="text-slate-900"
            />
          </div>
          <div class="text-slate-300 w-1/2">
            <Input
              label="Apellido"
              type="text"
              id="register-apellido"
              name="apellido"
              placeholder="García"
              autoComplete="family-name"
              required
              client:load
              className="text-slate-900"
            />
          </div>
        </div>

        <div class="text-slate-300">
          <Input
            label="Email"
            type="email"
            id="register-email"
            name="email"
            placeholder="usuario@gmail.com"
            autoComplete="email"
            required
            client:load
            className="text-slate-900"
          />
        </div>

        <div class="text-slate-300">
          <Input
            label="Contraseña"
            type="password"
            id="register-password"
            name="password"
            placeholder="Mínimo 8 caracteres"
            autoComplete="new-password"
            required
            client:load
            className="text-slate-900"
          />
        </div>

        <div class="text-slate-300">
          <Input
            label="Confirmar contraseña"
            type="password"
            id="register-password-confirm"
            name="password_confirm"
            placeholder="Repetí tu contraseña"
            autoComplete="new-password"
            required
            client:load
            className="text-slate-900"
          />
        </div>

        <p class="text-slate-400 text-xs text-center mt-2">
          Al registrarte aceptás nuestros{" "}
          <a href="#" class="text-cyan-400 hover:text-cyan-300 transition-colors">Términos de uso</a>
          {" "}y{" "}
          <a href="#" class="text-cyan-400 hover:text-cyan-300 transition-colors">Política de privacidad</a>.
        </p>

        <div class="mt-2">
          <Button type="submit" fullWidth variant="secondary" client:load id="register-submit">
            Crear cuenta
          </Button>
        </div>
      </form>

      <p class="mt-8 text-center text-slate-400 text-sm">
        ¿Ya tenés cuenta?{" "}
        <a href="/login" class="text-cyan-400 font-medium hover:text-cyan-300 transition-colors">Iniciá sesión</a>
      </p>
    </div>
  </div>
</Layout>

<script>
  import { setUser } from '../lib/session';
  import { supabase } from '../lib/supabase';

  const form = document.getElementById("register-form") as HTMLFormElement | null;
  const pwd = document.getElementById("register-password") as HTMLInputElement | null;
  const pwdConfirm = document.getElementById("register-password-confirm") as HTMLInputElement | null;
  const nombre = document.getElementById("register-nombre") as HTMLInputElement | null;
  const apellido = document.getElementById("register-apellido") as HTMLInputElement | null;
  const email = document.getElementById("register-email") as HTMLInputElement | null;
  const mensajeEstado = document.getElementById("mensaje-estado") as HTMLElement | null;

  const setMensaje = (texto: string, color: string) => {
    if (!mensajeEstado) return;
    mensajeEstado.innerText = texto;
    mensajeEstado.style.color = color;
  };

  const validar = (): boolean => {
    if (!nombre || !apellido || !email || !pwd || !pwdConfirm) return false;

    if (!nombre.value.trim() || !apellido.value.trim()) {
      setMensaje("Completá nombre y apellido.", "#ef4444");
      return false;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
      setMensaje("Ingresá un email válido.", "#ef4444");
      return false;
    }
    if (pwd.value.length < 8) {
      setMensaje("La contraseña debe tener al menos 8 caracteres.", "#ef4444");
      return false;
    }
    if (pwd.value !== pwdConfirm.value) {
      pwdConfirm.setCustomValidity("Las contraseñas no coinciden");
      setMensaje("Las contraseñas no coinciden.", "#ef4444");
      return false;
    }
    pwdConfirm.setCustomValidity("");
    return true;
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!validar()) return;
    const submitBtn = document.getElementById("register-submit") as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Creando cuenta...";
    }

    try {
      setMensaje("Registrando usuario...", "#06b6d4");

      const nombreCompleto = `${nombre!.value} ${apellido!.value}`.trim();
      const emailValue = email!.value.trim();

      // 1. Crear usuario en Supabase Auth (manda email de verificación automáticamente)
      console.log('[REGISTRO] Intentando signUp con email:', emailValue);
      const { data, error } = await supabase.auth.signUp({
        email: emailValue,
        password: pwd!.value,
        options: {
          data: { nombre: nombreCompleto },
        },
      });
      console.log('[REGISTRO] Supabase respuesta:', { user: data?.user?.id, error: error?.message, session: data?.session });

      if (error) {
        console.error('[REGISTRO] Supabase error:', error);
        const msg = error.message.includes('already registered')
          ? 'Este email ya está registrado.'
          : error.message;
        setMensaje(msg, "#ef4444");
        return;
      }

      // 2. Crear usuario en Neon para las publicaciones
      if (data.user) {
        await fetch('/Apis/registro', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            usuario: nombreCompleto,
            email: emailValue,
            supabase_id: data.user.id,
          }),
        });
      }

      setMensaje("¡Te enviamos un email! Verificá tu casilla para activar la cuenta.", "#10b981");
      setTimeout(() => { window.location.href = '/login'; }, 3000);

    } catch (error) {
      console.error("Error en el registro:", error);
      setMensaje("Error de conexión con el servidor.", "#ef4444");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Crear cuenta";
      }
    }
  });

  pwdConfirm?.addEventListener("input", () => {
    pwdConfirm.setCustomValidity("");
  });
</script>
