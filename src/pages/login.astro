---
import Layout from "../layouts/Layout.astro";
import { Button } from "../components/ui/Button";
import { Input } from "../components/ui/Input";
import Logo from "../components/Logo.astro";
import "../styles/auth.css";
---

<Layout title="Iniciar Sesión">
  <div class="auth-page">
    <div class="auth-page__layout">
      <section class="auth-form">
        <header class="auth-form__cabecera">
          <a href="/" class="auth-form__logo">
            <Logo variant="claro" />
          </a>
          <h1 class="auth-form__titulo">Iniciar sesión</h1>
          <p class="auth-form__estado" id="mensaje-estado" role="note">
            Ingresá tus credenciales para continuar.
          </p>
        </header>

        <a href="/Apis/auth/google" class="auth-form__boton-social" rel="nofollow">
          <img src="/google-favicon.png" alt="" width="18" height="18" class="auth-form__google" />
          Continuar con Google
        </a>

        <div class="auth-form__divisor"><span>o</span></div>

        <form id="loginForm" novalidate>
          <div>
            <Input
              id="emailInput"
              label="Email"
              type="email"
              placeholder="usuario@gmail.com"
              autoComplete="email"
              required
              client:load
            />
            <p class="auth-form__error" id="error-email" role="alert"></p>
          </div>
          <div>
            <Input
              id="passwordInput"
              label="Contraseña"
              type="password"
              placeholder="••••••••"
              autoComplete="current-password"
              required
              client:load
            />
            <p class="auth-form__error" id="error-password" role="alert"></p>
          </div>

          <div>
            <Button type="submit" fullWidth variant="secondary" client:load id="login-submit">Ingresar</Button>
          </div>
        </form>

        <p class="auth-form__enlace-registro">
          <a href="/recuperar">¿Olvidaste tu contraseña?</a>
        </p>

        <div id="reset-ayuda" class="auth-form__reset" hidden>
          <p class="auth-form__reset-titulo">No pudimos validar esos datos</p>
          <p class="auth-form__reset-texto">
            Si el email es correcto y la contraseña no, podés elegir una nueva desde acá. También
            puede ser que la cuenta todavía no exista.
          </p>
          <a class="auth-form__reset-enlace" href="/recuperar">Restablecer mi contraseña</a>
          <a class="auth-form__reset-enlace auth-form__reset-enlace--secundario" href="/registro">
            Crear una cuenta
          </a>
        </div>

        <p class="auth-form__enlace-registro">
          ¿No tenés cuenta? <a href="/registro">Registrate</a>
        </p>
      </section>

      <aside class="auth-page__marca">
        <p class="auth-page__marca-esquina">Tasá tu propiedad en minutos, no en semanas.</p>
      </aside>
    </div>
  </div>

  <script>
    import { setUser } from '../lib/session';

    const form = document.getElementById('loginForm') as HTMLFormElement;
    const mensajeEstado = document.getElementById('mensaje-estado') as HTMLElement;
    const resetAyuda = document.getElementById('reset-ayuda') as HTMLElement | null;

    const setMensaje = (texto: string, color: string) => {
      mensajeEstado.innerText = texto;
      mensajeEstado.style.color = color;
    };

    const mostrarAyudaReset = () => {
      resetAyuda?.removeAttribute('hidden');
    };

    const errorUrl = new URLSearchParams(window.location.search).get('error');
    if (errorUrl) {
      setMensaje(errorUrl, '#ef4444');
      mostrarAyudaReset();
    }

    const errorEmail = document.getElementById('error-email') as HTMLParagraphElement;
    const errorPassword = document.getElementById('error-password') as HTMLParagraphElement;

    const marcarError = (campo: HTMLInputElement, nodo: HTMLParagraphElement | null, mensaje: string) => {
      campo.setAttribute('aria-invalid', 'true');
      campo.classList.add('auth-form__entrada', 'auth-form__entrada--invalida');
      if (nodo) nodo.textContent = mensaje;
    };
    const limpiarError = (campo: HTMLInputElement, nodo: HTMLParagraphElement | null) => {
      campo.removeAttribute('aria-invalid');
      campo.classList.remove('auth-form__entrada', 'auth-form__entrada--invalida');
      if (nodo) nodo.textContent = '';
    };

    const emailElementInit = document.getElementById('emailInput') as HTMLInputElement;
    const passwordElementInit = document.getElementById('passwordInput') as HTMLInputElement;
    emailElementInit.addEventListener('input', () => limpiarError(emailElementInit, errorEmail));
    passwordElementInit.addEventListener('input', () => limpiarError(passwordElementInit, errorPassword));

    const validar = (): boolean => {
      const email = emailElementInit.value.trim();
      const password = passwordElementInit.value;
      limpiarError(emailElementInit, errorEmail);
      limpiarError(passwordElementInit, errorPassword);

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        marcarError(emailElementInit, errorEmail, 'Ingresá un email válido.');
        return false;
      }
      if (password.length < 8) {
        marcarError(passwordElementInit, errorPassword, 'La contraseña debe tener al menos 8 caracteres.');
        return false;
      }
      return true;
    };

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validar()) return;

      const emailElement = document.getElementById('emailInput') as HTMLInputElement;
      const passwordElement = document.getElementById('passwordInput') as HTMLInputElement;
      const submitBtn = document.getElementById('login-submit') as HTMLButtonElement | null;

      const body = {
        email: emailElement.value.trim(),
        contraseña: passwordElement.value
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Ingresando...";
      }

      try {
        setMensaje("Verificando credenciales...", "#06b6d4");
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 10000);

        let res: Response;
        try {
          res = await fetch('/Apis/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
            signal: controller.signal
          });
        } finally {
          clearTimeout(timeoutId);
        }

        const data = await res.json().catch(() => null);

        if (res.ok && data?.success) {
          setMensaje("¡Éxito! Redirigiendo...", "#10b981");
          setUser({ nombre: data.username, id: data.id });
          window.location.href = '/dashboard';
        } else {
          setMensaje(`${data?.error || 'Error al iniciar sesión'}`, "#ef4444");
          marcarError(passwordElement, errorPassword, data?.error || 'No pudimos iniciar sesión. Revisá tus datos.');
          mostrarAyudaReset();
        }
      } catch (error) {
        console.error("Error en la petición:", error);
        setMensaje("No se pudo conectar con el servidor.", "#ef4444");
        marcarError(passwordElement, errorPassword, 'No se pudo conectar con el servidor.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Ingresar";
        }
      }
    });
  </script>
</Layout>
