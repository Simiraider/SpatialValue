---
import Layout from "../layouts/Layout.astro";
import { Button } from "../components/ui/Button";
import { Input } from "../components/ui/Input";
import Logo from "../components/Logo.astro";
import "../styles/auth.css";
---

<Layout title="Iniciar Sesión">
  <div class="auth-page">
    <div class="auth-layout">
      <section class="auth-form">
        <header class="auth-form__cabecera">
          <a href="/" class="auth-logo">
            <Logo variant="claro" />
          </a>
          <h1 class="auth-title">Iniciar sesión</h1>
          <p class="auth-status" id="mensaje-estado" role="note">
            Ingresá tus credenciales para continuar.
          </p>
        </header>

        <button type="button" class="auth-btn-social" id="btn-google">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="..."/></svg>
        Continuar con Google
        </button>

        <div class="auth-divider"><span>o</span></div>

        <form id="loginForm" novalidate>
          <div>
            <Input
              id="emailInput"
              label="Email"
              type="email"
              placeholder="usuario@gmail.com"
              autoComplete="email"
              required
              client:load
            />
            <p class="auth-error" id="error-email" role="alert"></p>
          </div>
          <div>
            <Input
              id="passwordInput"
              label="Contraseña"
              type="password"
              placeholder="••••••••"
              autoComplete="current-password"
              required
              client:load
            />
            <p class="auth-error" id="error-password" role="alert"></p>
          </div>

          <div>
            <Button type="submit" fullWidth variant="secondary" client:load id="login-submit">Ingresar</Button>
          </div>
        </form>

        <div id="demo-fallback" class="hidden">
          <div class="auth-demo">
            <p class="auth-demo-titulo">No se pudo conectar con el servidor</p>
            <p class="auth-demo-texto">
              Podés explorar la app en <strong>modo demo</strong> con datos de ejemplo. Tu cuenta real no se verá afectada.
            </p>
            <Button variant="outline" fullWidth type="button" client:load id="btn-modo-demo">
              Continuar en modo demo
            </Button>
          </div>
        </div>

        <p class="auth-switch">
          ¿No tenés cuenta? <a href="/registro">Registrate</a>
        </p>
      </section>

      <aside class="auth-marca">
        <p class="auth-marca-esquina">Tasá tu propiedad en minutos, no en semanas.</p>
      </aside>
    </div>
  </div>

  <script>
    import { setUser } from '../lib/session';

    const form = document.getElementById('loginForm') as HTMLFormElement;
    const mensajeEstado = document.getElementById('mensaje-estado') as HTMLElement;
    const demoFallback = document.getElementById('demo-fallback') as HTMLElement | null;

    document.getElementById('btn-google')?.addEventListener('click', () => {
    window.location.href = '/Apis/auth/google';
    });

    const setMensaje = (texto: string, color: string) => {
      mensajeEstado.innerText = texto;
      mensajeEstado.style.color = color;
    };

    const entrarDemo = () => {
      setMensaje("Modo demo activado — redirigiendo...", "#f59e0b");
      document.cookie = "usuario_id=demo-user; path=/";
      setUser({ nombre: 'Demo', id: 'demo-user', demo: true });
      setTimeout(() => { window.location.href = '/dashboard'; }, 800);
    };

    const errorEmail = document.getElementById('error-email') as HTMLParagraphElement;
    const errorPassword = document.getElementById('error-password') as HTMLParagraphElement;

    const marcarError = (campo: HTMLInputElement, nodo: HTMLParagraphElement | null, mensaje: string) => {
      campo.setAttribute('aria-invalid', 'true');
      campo.classList.add('auth-input--invalido');
      if (nodo) nodo.textContent = mensaje;
    };
    const limpiarError = (campo: HTMLInputElement, nodo: HTMLParagraphElement | null) => {
      campo.removeAttribute('aria-invalid');
      campo.classList.remove('auth-input--invalido');
      if (nodo) nodo.textContent = '';
    };

    const emailElementInit = document.getElementById('emailInput') as HTMLInputElement;
    const passwordElementInit = document.getElementById('passwordInput') as HTMLInputElement;
    emailElementInit.addEventListener('input', () => limpiarError(emailElementInit, errorEmail));
    passwordElementInit.addEventListener('input', () => limpiarError(passwordElementInit, errorPassword));

    const validar = (): boolean => {
      const email = emailElementInit.value.trim();
      const password = passwordElementInit.value;
      limpiarError(emailElementInit, errorEmail);
      limpiarError(passwordElementInit, errorPassword);

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        marcarError(emailElementInit, errorEmail, 'Ingresá un email válido.');
        return false;
      }
      if (password.length < 8) {
        marcarError(passwordElementInit, errorPassword, 'La contraseña debe tener al menos 8 caracteres.');
        return false;
      }
      return true;
    };

    demoFallback?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('#btn-modo-demo')) entrarDemo();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validar()) return;

      const emailElement = document.getElementById('emailInput') as HTMLInputElement;
      const passwordElement = document.getElementById('passwordInput') as HTMLInputElement;
      const submitBtn = document.getElementById('login-submit') as HTMLButtonElement | null;

      const body = {
        email: emailElement.value.trim(),
        contraseña: passwordElement.value
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Ingresando...";
      }

      try {
        setMensaje("Verificando credenciales...", "#06b6d4");
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 10000);

        let res: Response;
        try {
          res = await fetch('/Apis/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
            signal: controller.signal
          });
        } finally {
          clearTimeout(timeoutId);
        }

        const data = await res.json().catch(() => null);

        if (res.ok && data?.success) {
          setMensaje("¡Éxito! Redirigiendo...", "#10b981");
          setUser({ nombre: data.username, id: data.id });
          window.location.href = '/dashboard';
        } else {
          setMensaje(`${data?.error || 'Error al iniciar sesión'}`, "#ef4444");
          marcarError(passwordElement, errorPassword, data?.error || 'No pudimos iniciar sesión. Revisá tus datos.');
          if (demoFallback) demoFallback.classList.remove('hidden');
        }
      } catch (error) {
        console.error("Error en la petición:", error);
        setMensaje("No se pudo conectar con el servidor.", "#ef4444");
        marcarError(passwordElement, errorPassword, 'No se pudo conectar con el servidor.');
        if (demoFallback) demoFallback.classList.remove('hidden');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Ingresar";
        }
      }
    });
  </script>
</Layout>
