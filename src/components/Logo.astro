---
interface Props {
  variant?: "oscuro" | "claro";
  class?: string;
}
const { variant = "oscuro", class: className = "" } = Astro.props;
const src =
  variant === "claro"
    ? "/logo-spatialvalue-claro.png"
    : "/logo-spatialvalue-oscuro.png";
---

<img src={src} alt="SpatialValue" class:list={["logo__imagen", className]} />

<style>
  img {
    display: block;
    object-fit: contain;
  }
</style>
