---
---
<section class="showcase" aria-label="Ejemplo de reporte de tasación">
  <h2 class="sr-only">Reporte de tasación generado por SpatialValue</h2>
  <div class="laptop" aria-hidden="true" data-reveal style="--reveal-delay: 0.1s">
    <div class="laptop__pantalla">
      <div class="reporte-demo">
        <header class="reporte-demo__superior">
          <span class="reporte-demo__id">IX · 85fed55a-97fb-404a-959c-e87bf024866a · 20/10/2026</span>
          <span class="reporte-demo__descarga">↓ Descargar PDF</span>
        </header>
        <h3 class="reporte-demo__titulo">Reporte final - Dragones 1871</h3>
        <p class="reporte-demo__subtitulo">Estimación por método comparativo de mercado (USD/m² de referencia del barrio)</p>
        <div class="reporte-demo__tarjeta">
          <p class="reporte-demo__etiqueta">Valor total estimado</p>
          <p class="reporte-demo__valor">245.000 USD</p>
          <p class="reporte-demo__valor-ars">3.735.600 ARS</p>
          <p class="reporte-demo__rango">Rango de mercado: entre 230.000 y 265.000 USD</p>
          <div class="reporte-demo__barra">
            <span class="reporte-demo__punto" style="left: 6%"></span>
            <span class="reporte-demo__punto reporte-demo__punto--referencia" style="left: 50%"></span>
            <span class="reporte-demo__punto" style="left: 94%"></span>
          </div>
          <div class="reporte-demo__escala"><span>230,000</span><span>Referencia</span><span>265,000</span></div>
        </div>
        <div class="reporte-demo__pestanas">
          <span class="reporte-demo__pestana reporte-demo__pestana--activa">Resumen</span>
          <span class="reporte-demo__pestana">Análisis técnico</span>
        </div>
        <div class="reporte-demo__datos">
          <h4>Datos de la propiedad</h4>
          <p class="reporte-demo__datos-nota">Datos declarados en el formulario; no medidos ni verificados de forma independiente.</p>
          <div class="reporte-demo__datos-grilla">
            <div><small>Barrio</small><b>Belgrano</b></div>
            <div><small>Tipo</small><b>casa</b></div>
            <div><small>Superficie total</small><b>500 m²</b></div>
            <div><small>Superficie cubierta</small><b>350 m²</b></div>
            <div><small>Superficie descubierta</small><b>150 m²</b></div>
            <div><small>Antigüedad</small><b>12 años</b></div>
            <div><small>Ambientes</small><b>5</b></div>
            <div><small>Dormitorios</small><b>3</b></div>
          </div>
        </div>
      </div>
    </div>
    <div class="laptop__base"></div>
  </div>
</section>
