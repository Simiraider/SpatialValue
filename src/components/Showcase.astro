---
// Si la foto del laptop existe en /showcase/laptop-reporte.jpg la tapa el mockup;
// si no, se remueve sola y queda el mockup CSS construido abajo.
---
<section class="showcase" aria-label="Ejemplo de reporte de tasación">
  <h2 class="sr-only">Reporte de tasación generado por SpatialValue</h2>
  <img
    class="showcase-photo"
    src="/showcase/laptop-reporte.jpg"
    alt="Laptop sobre un escritorio mostrando un reporte final de tasación"
    data-reveal
    onerror="this.remove()"
  />
  <div class="laptop" aria-hidden="true" data-reveal style="--reveal-delay: 0.1s">
    <div class="laptop-screen">
      <div class="report">
        <header class="report-top">
          <span class="report-id">IX · 85fed55a-97fb-404a-959c-e87bf024866a · 20/10/2026</span>
          <span class="report-dl">↓ Descargar PDF</span>
        </header>
        <h3 class="report-title">Reporte final - Dragones 1871</h3>
        <p class="report-sub">Estimación por método comparativo de mercado (USD/m² de referencia del barrio)</p>
        <div class="report-card">
          <p class="rc-label">Valor total estimado</p>
          <p class="rc-value">245.000 USD</p>
          <p class="rc-ars">3.735.600 ARS</p>
          <p class="rc-range">Rango de mercado: entre 230.000 y 265.000 USD</p>
          <div class="rc-bar">
            <span class="rc-dot" style="left: 6%"></span>
            <span class="rc-dot rc-dot-ref" style="left: 50%"></span>
            <span class="rc-dot" style="left: 94%"></span>
          </div>
          <div class="rc-scale"><span>230,000</span><span>Referencia</span><span>265,000</span></div>
        </div>
        <div class="report-tabs">
          <span class="tab tab-active">Resumen</span>
          <span class="tab">Análisis técnico</span>
        </div>
        <div class="report-data">
          <h4>Datos de la propiedad</h4>
          <p class="data-note">Datos declarados en el formulario; no medidos ni verificados de forma independiente.</p>
          <div class="data-grid">
            <div><small>Barrio</small><b>Belgrano</b></div>
            <div><small>Tipo</small><b>casa</b></div>
            <div><small>Superficie total</small><b>500 m²</b></div>
            <div><small>Superficie cubierta</small><b>350 m²</b></div>
            <div><small>Superficie descubierta</small><b>150 m²</b></div>
            <div><small>Antigüedad</small><b>12 años</b></div>
            <div><small>Ambientes</small><b>5</b></div>
            <div><small>Dormitorios</small><b>3</b></div>
          </div>
        </div>
      </div>
    </div>
    <div class="laptop-base"></div>
  </div>
</section>
