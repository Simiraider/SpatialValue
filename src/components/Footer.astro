---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <Logo />
          <span>SpatialValue</span>
        </a>
        <p>Tasación inmobiliaria basada en datos, no en opiniones.</p>
      </div>

      <div>
        <h4>Empresa</h4>
        <ul>
          <li><a href="#quienes-somos">Sobre nosotros</a></li>
        </ul>
      </div>

      <div id="precios">
        <h4>Datos y legal</h4>
        <ul>
          <li><a href="https://www.argentina.gob.ar/tribunal-de-tasaciones-de-la-nacion/normas-nacionales-de-valuacion">Tribunal de Tasaciones</a></li>
          <li><a href="https://www.argentina.gob.ar/pedido-de-tasacion">Marco Institucional y Colegios</a></li>
        </ul>
      </div>
    </div>

    <p class="footer-bottom">&copy; {year} SpatialValue. Proyecto académico.</p>
  </div>
</footer>
