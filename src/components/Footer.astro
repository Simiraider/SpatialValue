---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <Logo variant="oscuro" />
        </a>
        <p>Tasación inmobiliaria basada en datos, no en opiniones.</p>
      </div>

      <nav class="footer-links" aria-label="Enlaces del pie de página">
        <a href="/#quienes-somos">Quiénes somos</a>
        <a href="https://www.argentina.gob.ar/tribunal-de-tasaciones-de-la-nacion/normas-nacionales-de-valuacion">Tribunal de tasaciones</a>
        <a href="https://www.argentina.gob.ar/pedido-de-tasacion">Marco Institucional y Colegios</a>
      </nav>
    </div>

    <p class="footer-bottom">
      &copy; {year} <Logo variant="oscuro" class="footer-logo-inline" />. Proyecto académico.
    </p>
  </div>
</footer>
