---
import Layout from '../../layouts/Layout.astro';
import Logo from '../Logo.astro';

interface Accion {
  texto: string;
  href?: string;
  recargar?: boolean;
}

interface Props {
  codigo: string;
  titulo: string;
  subtitulo: string;
  principal: Accion;
  secundaria?: Accion;
  pista?: string;
  soporte?: boolean;
}

const { codigo, titulo, subtitulo, principal, secundaria, pista, soporte = false } = Astro.props;
const emailSoporte = String(import.meta.env.PUBLIC_EMAIL_SOPORTE ?? '').trim();
---

<Layout title={`Error ${codigo}`}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main class="error">
    <div class="error__caja">
      <div class="error__marco" aria-hidden="true">
        <div class="error__pantalla">
          <span class="error__codigo">{codigo}</span>
          <div class="error__barrido"></div>

          <div class="error__rebote-x">
            <div class="error__rebote-y">
              <span class="error__logo-marco">
                <Logo variant="claro" class="error__logo" />
              </span>
            </div>
          </div>

          <div class="error__ruido"></div>
        </div>

        <div class="error__base">
          <span class="error__led"></span>
          <span class="error__marca">SPATIAL VALUE · SEÑAL</span>
        </div>
      </div>

      <div class="error__texto">
        <p class="error__etiqueta">Error {codigo}</p>
        <h1 class="error__titulo">{titulo}</h1>
        <p class="error__subtitulo">{subtitulo}</p>

        <div class="error__acciones">
          {
            principal.recargar ? (
              <button type="button" class="error__boton error__boton--primario" onclick="location.reload()">
                {principal.texto}
              </button>
            ) : (
              <a class="error__boton error__boton--primario" href={principal.href ?? '/'}>
                {principal.texto}
              </a>
            )
          }
          {
            secundaria && (
              <a class="error__boton error__boton--secundario" href={secundaria.href ?? '/'}>
                {secundaria.texto}
              </a>
            )
          }
        </div>

        {
          soporte && (
            <p class="error__soporte">
              ¿Necesitás una tasación urgente?{' '}
              {emailSoporte ? (
                <>
                  Escribinos a <a href={`mailto:${emailSoporte}`}>{emailSoporte}</a>.
                </>
              ) : (
                <>Volvé a intentar en unos minutos.</>
              )}
            </p>
          )
        }

        {pista && <p class="error__pista">{pista}</p>}
      </div>
    </div>
  </main>
</Layout>

<style>
  .error {
    --logo: 5.5rem;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 5vw, 4rem) 1.25rem;
    background:
      radial-gradient(circle at 20% 0%, rgba(0, 135, 192, 0.12), transparent 55%),
      radial-gradient(circle at 90% 100%, rgba(46, 48, 54, 0.1), transparent 50%),
      var(--color-bg, #f8fafc);
    font-family: var(--font-sans, system-ui, sans-serif);
    color: var(--color-text, #0f172a);
  }

  .error__caja {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
    width: 100%;
    max-width: 1040px;
  }

  @media (min-width: 900px) {
    .error__caja {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  /* ── Marco estilo televisor viejo ───────────────────────────────── */

  .error__marco {
    position: relative;
    padding: 0.75rem 0.75rem 0;
    border-radius: 1.75rem;
    background: linear-gradient(160deg, #3a3d45, #23252b 60%, #1b1d21);
    box-shadow:
      0 24px 60px -24px rgba(15, 23, 42, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .error__pantalla {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 1.15rem;
    background:
      radial-gradient(ellipse at 50% 40%, #0d3b4f 0%, #071e28 55%, #040d12 100%);
    box-shadow:
      inset 0 0 60px rgba(0, 0, 0, 0.9),
      inset 0 0 18px rgba(0, 200, 255, 0.15);
  }

  .error__codigo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display, 'Poppins', system-ui, sans-serif);
    font-size: clamp(3.5rem, 13vw, 6.5rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(120, 210, 240, 0.22);
    text-shadow: 0 0 28px rgba(0, 175, 235, 0.35);
    user-select: none;
  }

  /* Líneas de barrido del tubo */
  .error__barrido {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.055) 0px,
      rgba(255, 255, 255, 0.055) 1px,
      transparent 1px,
      transparent 3px
    );
    pointer-events: none;
  }

  /* El logo rebota: eje X y eje Y con duraciones distintas y "alternate"
     para reflejarse en las paredes y llegar también a las esquinas. */
  .error__rebote-x {
    position: absolute;
    inset: 0;
    animation: error-rebote-x 13s linear infinite alternate;
    will-change: transform;
  }

  .error__rebote-y {
    position: absolute;
    inset: 0;
    animation: error-rebote-y 8s linear infinite alternate;
    will-change: transform;
  }

  @keyframes error-rebote-x {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(100% - var(--logo)));
    }
  }

  @keyframes error-rebote-y {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(100% - var(--logo)));
    }
  }

  .error__logo-marco {
    display: block;
    width: var(--logo);
    padding: 0.5rem;
  }

  .error__logo-marco :global(img) {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 0 10px rgba(0, 190, 255, 0.55));
  }

  /* Grano / parpadeo tenue del CRT */
  .error__ruido {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.5) 100%);
    animation: error-parpadeo 6s steps(2, end) infinite;
  }

  @keyframes error-parpadeo {
    0%,
    100% {
      opacity: 1;
    }
    48% {
      opacity: 0.94;
    }
    50% {
      opacity: 1;
    }
  }

  .error__base {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.35rem 0.85rem;
  }

  .error__led {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #35e07f;
    box-shadow: 0 0 8px rgba(53, 224, 127, 0.9);
    animation: error-led 2.4s ease-in-out infinite;
  }

  @keyframes error-led {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .error__marca {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
  }

  /* ── Texto y acciones ───────────────────────────────────────────── */

  .error__texto {
    max-width: 34rem;
  }

  .error__etiqueta {
    margin: 0 0 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brand, #0087c0);
  }

  .error__titulo {
    margin: 0 0 0.9rem;
    font-family: var(--font-display, 'Poppins', system-ui, sans-serif);
    font-size: clamp(1.6rem, 4.4vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-graphite, #2e3036);
  }

  .error__subtitulo {
    margin: 0 0 1.9rem;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    line-height: 1.65;
    color: var(--color-text-muted, #4d4d4d);
  }

  .error__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .error__boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.9rem;
    padding: 0 1.5rem;
    border-radius: var(--radius-full, 999px);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .error__boton--primario {
    border: 1px solid var(--color-brand, #0087c0);
    background: var(--color-brand, #0087c0);
    color: #fff;
    box-shadow: 0 10px 24px -12px rgba(0, 135, 192, 0.85);
  }

  .error__boton--primario:hover {
    background: var(--color-brand-dark, #006b99);
    border-color: var(--color-brand-dark, #006b99);
    transform: translateY(-1px);
  }

  .error__boton--secundario {
    border: 1px solid var(--color-border, #d8dee8);
    background: #fff;
    color: var(--color-graphite, #2e3036);
  }

  .error__boton--secundario:hover {
    border-color: var(--color-brand, #0087c0);
    color: var(--color-brand-dark, #006b99);
    transform: translateY(-1px);
  }

  .error__boton:focus-visible {
    outline: 3px solid rgba(0, 135, 192, 0.45);
    outline-offset: 2px;
  }

  .error__soporte {
    margin: 1.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted, #4d4d4d);
  }

  .error__soporte a {
    color: var(--color-brand-dark, #006b99);
    font-weight: 600;
    text-decoration: underline;
  }

  .error__pista {
    margin: 1.1rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: #94a3b8;
  }

  @media (max-width: 560px) {
    .error {
      --logo: 4rem;
    }

    .error__marco {
      border-radius: 1.25rem;
      padding: 0.55rem 0.55rem 0;
    }

    .error__pantalla {
      border-radius: 0.85rem;
    }

    .error__boton {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .error__rebote-x,
    .error__rebote-y,
    .error__ruido,
    .error__led {
      animation: none;
    }

    .error__rebote-y {
      transform: translate(0, 0);
    }

    .error__rebote-x {
      transform: translate(0, 0);
    }
  }
</style>
