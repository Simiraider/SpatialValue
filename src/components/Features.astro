---
import Showcase from "./Showcase.astro";

const FLECHA = `<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.5 10h12m0 0-4.5-4.5M15.5 10 11 14.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const puntos = [
  {
    numero: 1,
    titulo: "Datos clave del inmueble",
    texto: "Recopilamos información esencial como ubicación, superficie y amenities para conocer las características de tu propiedad.",
  },
  {
    numero: 2,
    titulo: "Análisis inteligente de imágenes",
    texto: "Nuestra IA analiza pisos, techos y paredes para evaluar el estado de conservación del inmueble.",
  },
  {
    numero: 3,
    titulo: "Tasación basada en datos",
    texto: "Cruzamos datos históricos y propiedades similares de la zona para estimar un valor de mercado actualizado.",
  },
];

const team = [
  {
    name: "Manuel Smulovitz",
    role: "UX/UI",
    imageSrc: "/quienes-somos/manuel-smulovitz.png",
  },
  {
    name: "Liam Lutteral",
    role: "IA",
    imageSrc: "/quienes-somos/liam-lutteral.png",
  },
  {
    name: "Jonas Leiserson",
    role: "Back-End",
    imageSrc: "/quienes-somos/jonas-leiserson.png",
  },
  {
    name: "Simon Flomenboim",
    role: "Front-End",
    imageSrc: "/quienes-somos/simon-flomenboim.png",
  },
];
---

<section id="sobre-tasaciones" class="tasaciones">
  <div class="tasaciones-inner">
    <h2 class="tasaciones-title" data-reveal>
      Sobre las tasaciones<br /><em>inteligentes</em>
    </h2>

    <div class="tasaciones-grid">
      {puntos.map((punto, i) => (
        <article class="tasaciones-item" data-reveal style={`--reveal-delay: ${i * 0.12}s`}>
          <h3>{punto.numero}. {punto.titulo}</h3>
          <p>{punto.texto}</p>
        </article>
      ))}
    </div>

    <div class="tasaciones-cta" data-reveal style="--reveal-delay: 0.36s">
      <a href="/tasacion" class="tasaciones-cta-button" data-requiere-login>
        Comenzá a tasar <span set:html={FLECHA} />
      </a>
    </div>
  </div>
</section>

<Showcase />

<section id="quienes-somos" class="team-section">
  <div class="features-inner">
    <h2 class="features-title">¿Quienes Somos?</h2>
    <div class="team-grid">
      {team.map((person, i) => (
        <article class="team-member" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
          <img class="team-photo" src={person.imageSrc} alt={person.name} />
          <h3>{person.name}</h3>
          <p>{person.role}</p>
        </article>
      ))}
    </div>
  </div>
</section>
