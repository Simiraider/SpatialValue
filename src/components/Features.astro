---
const features = [
  {
    iconSrc: "/icons/inspeccion.svg",
    description:
      "Nuestro cuestionario está diseñado para recolectar las variables clave de tu inmueble, como superficie, ubicación y amenities, acorde a las exigencias del mercado actual.",
  },
  {
    iconSrc: "/icons/macro.svg",
    description:
      "Las imágenes son procesadas por nuestra Inteligencia Artificial para analizar automáticamente el estado de conservación de la propiedad, evaluando pisos, techos y paredes.",
  },
  {
    iconSrc: "/icons/gemelo.svg",
    description:
      "Cruzamos tu información con valores históricos y propiedades en tu zona para calcular una tasación precisa, transparente y en tiempo real.",
  },
];

const team = [
  {
    name: "Manuel Smulovitz",
    role: "UX/UI",
    imageSrc: "/quienes-somos/manuel-smulovitz.png",
  },
  {
    name: "Liam Lutteral",
    role: "IA",
    imageSrc: "/quienes-somos/liam-lutteral.png",
  },
  {
    name: "Jonas Leiserson",
    role: "Back-End",
    imageSrc: "/quienes-somos/jonas-leiserson.png",
  },
  {
    name: "Simon Flomenboim",
    role: "Front-End",
    imageSrc: "/quienes-somos/simon-flomenboim.png",
  },
];
---

<section id="sobre-tasaciones" class="features">
  <div class="features-inner">
    <h2 class="features-title">Sobre Las Tasaciones</h2>
    <div class="features-grid">
      {features.map((feature) => (
        <article class="feature-card">
          <div class="feature-icon">
            <img src={feature.iconSrc} alt="" width="28" height="28" />
          </div>
          <p>{feature.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="quienes-somos" class="team-section">
  <div class="features-inner">
    <h2 class="features-title">¿Quienes Somos?</h2>
    <div class="team-grid">
      {team.map((person) => (
        <article class="team-member">
          <img class="team-photo" src={person.imageSrc} alt={person.name} />
          <h3>{person.name}</h3>
          <p>{person.role}</p>
        </article>
      ))}
    </div>
  </div>
</section>
