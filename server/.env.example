# ── Servidor ────────────────────────────────────────────────────────────────
PORT=4000
# Origen(es) permitidos para CORS. "*" = cualquiera (solo para desarrollo).
# En producción poné el dominio del frontend, p.ej. https://spatialvalue.vercel.app
CORS_ORIGIN=*

# ── Modo de reconstrucción ───────────────────────────────────────────────────
# auto    → usa COLMAP si está instalado; si no, genera un modelo de demostración (simulador)
# colmap  → fuerza COLMAP real (falla con error claro si no está instalado)
# simular → siempre genera el modelo de demostración (útil para pruebas / free tier)
GEMELO_MODO=auto

# ── Límites y retención ──────────────────────────────────────────────────────
# Cantidad mínima de fotos para crear un trabajo (el frontend ya lo valida)
GEMELO_MIN_FOTOS=5
# Cantidad máxima de fotos por trabajo
GEMELO_MAX_FOTOS=100
# Tamaño máximo de un video (MB). De él se extraen cuadros con ffmpeg.
GEMELO_MAX_VIDEO_MB=300
# Horas que el modelo .glb queda disponible antes de ser eliminado (TTL).
# Las fotos NUNCA se guardan: se borran al terminar de procesar.
GEMELO_TTL_HORAS=1

# ── Rutas y binarios ─────────────────────────────────────────────────────────
# Directorio de trabajo del worker (fotos temporales, modelos, estado de trabajos)
GEMELO_DATA_DIR=./data
COLMAP_BIN=colmap
FFMPEG_BIN=ffmpeg

# ── Seguridad (opcional) ─────────────────────────────────────────────────────
# Si se define, las peticiones al worker deben incluir el header "X-Worker-Token".
# El frontend nunca lo envía: se usa para endpoints de administración.
WORKER_TOKEN=

# ── Almacenamiento en la nube (OPCIONAL, por defecto se sirve el modelo local) ──
# Si completás S3_BUCKET, el .glb final se sube a S3/Backblaze B2 y se sirve desde ahí.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
