# ── Frontend Astro (copiar a .env.local) ──────────────────────────────────────
# URL pública del worker de reconstrucción 3D (server/).
# En producción: https://spatial-value-gemelo.onrender.com
PUBLIC_GEMELO_WORKER_URL=http://localhost:4000

# URL de la IA de tasación (FastAPI). En dev la levanta `npm run dev`.
IA_URL=http://127.0.0.1:8000

# Base de datos PostgreSQL (Neon). Se obtiene con: npx vercel env pull .env.local
# SpatialValueStorage_DATABASE_URL=postgres://...

# ── Variables del worker (ver server/.env.example) ────────────────────────────
